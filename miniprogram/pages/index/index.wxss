/* 12. Bottom Floating TabBar */
.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: rgba(11, 14, 22, 0.96);
  backdrop-filter: blur(20px);
  border-top: 1px solid rgba(229, 184, 105, 0.15);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  color: #64748B;
  transition: all 0.2s ease;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.tab-label {
  font-size: 20rpx;
  font-weight: 700;
}

.tab-active {
  color: #E5B869;
}
