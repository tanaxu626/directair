/** pages/index/index.wxss **/
/* DirectAir Morning Sky Azure & Pearlescent White Style (100% Native v1.39 - 航旅晨曦天青国内主流版) */

page {
  background: linear-gradient(180deg, #EBF3FC 0%, #F1F5F9 100%);
  background-attachment: fixed;
  color: #0F172A;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Segoe UI', Roboto, sans-serif;
  padding-bottom: 160rpx;
}

.container {
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

/* ==================== 1. FULLSCREEN RESPONSIVE CITY SEARCH ==================== */
.fullscreen-city-view {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #EBF3FC 0%, #F8FAFC 100%);
  z-index: 99999;
  display: flex;
  flex-direction: column;
  padding: env(safe-area-inset-top) 24rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  height: 100vh;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.top-spotlight-bar {
  display: flex;
  flex-direction: column;
  background: transparent;
  padding-bottom: 16rpx;
  border-bottom: 1px solid rgba(203, 213, 225, 0.6);
  flex-shrink: 0;
}

.fs-nav-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 18rpx;
}

.fs-back-btn {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1px solid #E2E8F0;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.fs-back-arrow {
  color: #2563EB;
  font-size: 28rpx;
  margin-right: 6rpx;
}

.fs-back-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #1E293B;
}

.fs-nav-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #1E40AF;
  letter-spacing: 1rpx;
}

.fs-cancel-text {
  font-size: 24rpx;
  color: #2563EB;
  font-weight: 800;
  padding: 8rpx 16rpx;
}

.fs-search-box-top {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1.5px solid #2563EB;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.12);
}

.fs-search-icon {
  font-size: 28rpx;
  color: #2563EB;
  margin-right: 14rpx;
}

.fs-input-top {
  flex: 1;
  font-size: 28rpx;
  color: #0F172A;
  height: 52rpx;
}

.fs-clear-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E2E8F0;
  color: #64748B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.fs-top-scroll-container {
  flex: 1;
  height: 0;
  box-sizing: border-box;
  padding: 20rpx 0 60rpx;
}

.top-match-group {
  display: flex;
  flex-direction: column;
}

.top-group-label-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.top-group-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #1E40AF;
}

.top-hint-label {
  font-size: 20rpx;
  color: #64748B;
}

.top-compact-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.top-match-row {
  background: #FFFFFF;
  border-radius: 22rpx;
  border: 1px solid #E2E8F0;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
}

.tm-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #EFF6FF;
  border: 1px solid #BFDBFE;
  color: #1D4ED8;
  font-size: 28rpx;
  font-weight: 900;
  font-family: monospace;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.tm-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.tm-name-line {
  display: flex;
  align-items: baseline;
}

.tm-city {
  font-size: 30rpx;
  font-weight: 900;
  color: #0F172A;
  margin-right: 12rpx;
}

.tm-airport {
  font-size: 22rpx;
  font-weight: 700;
  color: #475569;
}

.tm-note {
  font-size: 19rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.tm-cta {
  background: #2563EB;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.25);
}

.tm-cta-gold {
  background: linear-gradient(135deg, #D97706, #B45309);
  color: #FFFFFF;
}

/* ==================== NO-AIRPORT NEARBY TRANSIT STYLES ==================== */
.no-airport-transit-box {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  animation: fadeIn 0.2s ease-in-out;
}

.transit-banner-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #EFF6FF, #DBEAFE);
  border: 1.5px solid #93C5FD;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(37, 99, 235, 0.08);
}

.transit-icon-badge {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.transit-title-col {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.transit-main-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #1E3A8A;
}

.transit-sub-title {
  font-size: 21rpx;
  color: #2563EB;
  font-weight: 700;
  margin-top: 4rpx;
}

.transit-reason-card {
  background: #FFFFFF;
  border-radius: 22rpx;
  border: 1px solid #E2E8F0;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.03);
}

.tr-reason-text {
  font-size: 22rpx;
  color: #334155;
  line-height: 1.55;
}

.nearby-hubs-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.nearby-hub-card-rich {
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1.5px solid #BFDBFE;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
  position: relative;
}

.nhr-top-tag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1px solid #F1F5F9;
}

.nhr-tag-badge {
  font-size: 20rpx;
  font-weight: 900;
  color: #92400E;
  background: #FEF3C7;
  border: 1px solid #FDE68A;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

.nhr-score {
  font-size: 20rpx;
  font-weight: 800;
  color: #059669;
}

.nhr-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.nh-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: #EFF6FF;
  border: 1px solid #BFDBFE;
  color: #1D4ED8;
  font-size: 30rpx;
  font-weight: 900;
  font-family: monospace;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.nh-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.nh-name-line {
  display: flex;
  align-items: baseline;
}

.nh-city {
  font-size: 32rpx;
  font-weight: 900;
  color: #0F172A;
  margin-right: 12rpx;
}

.nh-port {
  font-size: 24rpx;
  font-weight: 700;
  color: #2563EB;
}

.nh-dist-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #64748B;
  margin-top: 4rpx;
}

.nh-cta-btn {
  background: linear-gradient(135deg, #2563EB, #1D4ED8);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.3);
}

.nhr-specs-box {
  background: #F8FAFC;
  border-radius: 20rpx;
  border: 1px solid #E2E8F0;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.nhr-spec-item {
  display: flex;
  align-items: flex-start;
  font-size: 21rpx;
  line-height: 1.5;
  color: #334155;
}

.nhr-spec-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.nhr-spec-text {
  flex: 1;
}

.spec-strong {
  font-weight: 800;
  color: #0F172A;
}

.nhr-spec-highlight {
  background: #ECFDF5;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  border: 1px solid #A7F3D0;
  color: #065F46;
}

.nhr-spec-highlight .spec-strong {
  color: #047857;
}

.top-custom-row {
  background: #FFFFFF;
  border: 1.5px dashed #2563EB;
  border-radius: 22rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Sections in Full-Screen Default State */
.top-sec-block {
  margin-bottom: 32rpx;
}

.top-block-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.top-block-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #1E40AF;
  margin-bottom: 14rpx;
  display: block;
}

.top-block-sub {
  font-size: 19rpx;
  color: #64748B;
}

.top-quick-pills-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.top-pill-loc {
  display: flex;
  align-items: center;
  background: #ECFDF5;
  border: 1px solid #A7F3D0;
  border-radius: 20rpx;
  padding: 12rpx 22rpx;
}

.loc-dot { color: #059669; font-size: 20rpx; margin-right: 6rpx; }
.loc-code { font-size: 24rpx; font-weight: 900; font-family: monospace; color: #047857; margin-right: 8rpx; }
.loc-name { font-size: 22rpx; font-weight: 700; color: #065F46; }

.top-pill-hist {
  display: flex;
  align-items: baseline;
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 18rpx;
  padding: 12rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.hist-code { font-size: 24rpx; font-weight: 900; font-family: monospace; color: #2563EB; margin-right: 6rpx; }
.hist-name { font-size: 22rpx; color: #334155; }

.top-grid-3col {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
}

.top-hub-pill {
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 22rpx;
  padding: 20rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.top-hub-active {
  background: #EFF6FF;
  border: 1.5px solid #2563EB;
}

.thp-code {
  font-size: 30rpx;
  font-weight: 900;
  font-family: monospace;
  color: #1D4ED8;
}

.top-hub-active .thp-code { color: #1E40AF; }

.thp-city {
  font-size: 24rpx;
  font-weight: 800;
  color: #0F172A;
  margin-top: 4rpx;
}

.thp-port {
  font-size: 17rpx;
  color: #64748B;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.top-hub-active .thp-port { color: #2563EB; }

/* ==================== 2. BRAND BAR & GENERAL STYLES ==================== */
.brand-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.brand-logo-wrap {
  display: flex;
  align-items: center;
}

.gold-wing-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #1E40AF, #2563EB);
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.wing-glyph {
  color: #FFFFFF;
  font-size: 32rpx;
  transform: rotate(45deg);
}

.brand-text-col {
  display: flex;
  flex-direction: column;
}

.brand-title-row {
  display: flex;
  align-items: baseline;
}

.brand-zh {
  font-size: 36rpx;
  font-weight: 900;
  color: #0F172A;
  margin-right: 8rpx;
  letter-spacing: 2rpx;
}

.brand-en {
  font-size: 30rpx;
  font-weight: 800;
  color: #1E40AF;
  letter-spacing: 1rpx;
}

.brand-badge {
  font-size: 18rpx;
  font-weight: 900;
  color: #92400E;
  background: #FEF3C7;
  border: 1px solid #FDE68A;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
}

.brand-sub {
  font-size: 19rpx;
  color: #64748B;
  margin-top: 2rpx;
}

.face-id-pill {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1px solid #E2E8F0;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}

.lock-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.face-id-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #1E293B;
}

/* 3. Common Card Style */
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 1px solid #E2E8F0;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
}

.card-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F172A;
}

.verified-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #047857;
  background: #ECFDF5;
  border: 1px solid #A7F3D0;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.future-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: #92400E;
  background: #FEF3C7;
  border: 1px solid #FDE68A;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.sub-hint {
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: block;
}

/* 4. Section Title Bar */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 16rpx;
  padding: 0 4rpx;
}

.sec-badge-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.sec-title-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #0F172A;
  flex: 1;
}

.sec-title-sub {
  font-size: 20rpx;
  color: #2563EB;
  font-weight: 700;
}

/* 5. Live Countdown Capsule (民航深蓝高对比度醒目票卡) */
.countdown-capsule {
  background: linear-gradient(135deg, #0F2B5C 0%, #1E3A8A 55%, #2563EB 100%);
  border-radius: 28rpx;
  border: 1px solid rgba(255, 255, 255, 0.15);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(30, 58, 138, 0.25);
}

.capsule-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.capsule-left {
  display: flex;
  flex-direction: column;
}

.capsule-tag-row {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #BFDBFE;
  margin-bottom: 8rpx;
}

.live-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #34D399;
  box-shadow: 0 0 10rpx #34D399;
  margin-right: 10rpx;
  animation: pulseGreen 2s infinite;
}

@keyframes pulseGreen {
  0% { transform: scale(0.95); opacity: 0.8; }
  50% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(0.95); opacity: 0.8; }
}

.airline-flight {
  color: #FFFFFF;
  font-weight: 800;
}

.dot-divider {
  margin: 0 8rpx;
  color: rgba(255, 255, 255, 0.4);
}

.gold-bold {
  color: #FDE047;
  font-weight: 800;
}

.white-bold {
  color: #FFFFFF;
  font-weight: 800;
}

.capsule-route-row {
  display: flex;
  align-items: baseline;
}

.route-city {
  font-size: 40rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.route-plane {
  font-size: 26rpx;
  color: #93C5FD;
  margin: 0 14rpx;
}

.ontime-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: #065F46;
  background: #A7F3D0;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 14rpx;
}

.capsule-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.countdown-label-row {
  display: flex;
  align-items: center;
}

.countdown-label {
  font-size: 18rpx;
  font-weight: 800;
  color: #93C5FD;
  letter-spacing: 1rpx;
}

.arrow-right {
  font-size: 18rpx;
  color: #93C5FD;
  margin-left: 4rpx;
}

.countdown-digits {
  font-size: 40rpx;
  font-weight: 900;
  font-family: monospace;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  margin: 4rpx 0;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.countdown-legend {
  font-size: 14rpx;
  font-weight: 700;
  color: #93C5FD;
  letter-spacing: 2rpx;
}

.capsule-progress-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.2);
}

.capsule-progress-active {
  height: 100%;
  background: linear-gradient(90deg, #34D399, #60A5FA);
  box-shadow: 0 0 10rpx #34D399;
}

/* ==================== 6. CHINESE-CENTRIC CITY PAIR CAPSULE (中文大字主导) ==================== */
.segmented-control {
  display: flex;
  background: #F1F5F9;
  border-radius: 20rpx;
  border: 1px solid #E2E8F0;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 0;
  border-radius: 16rpx;
  color: #64748B;
}

.seg-active {
  background: #FFFFFF;
  color: #2563EB;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.seg-active-gold {
  background: #FFFFFF;
  color: #D97706;
  font-weight: 800;
  box-shadow: 0 4rpx 12rpx rgba(217, 119, 6, 0.12);
}

.city-pair-box {
  background: #F8FAFC;
  border-radius: 24rpx;
  border: 1px solid #E2E8F0;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.city-col {
  display: flex;
  flex-direction: column;
}

.city-left { align-items: flex-start; }
.city-right { align-items: flex-end; }

.city-hint-label {
  font-size: 18rpx;
  color: #64748B;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.city-name-huge {
  font-size: 44rpx;
  font-weight: 900;
  color: #0F172A;
  line-height: 1.1;
}

.city-sub-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.airport-code-badge {
