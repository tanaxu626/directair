/** pages/index/index.wxss **/
/* DirectAir Skyward Dark Velvet Luxury Style */

page {
  background-color: #07090E;
  color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  padding-bottom: 160rpx;
}

.container {
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

/* 1. Top Brand Header */
.brand-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.brand-logo-wrap {
  display: flex;
  align-items: center;
}

.gold-wing-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(223, 169, 56, 0.25), rgba(243, 206, 114, 0.05));
  border: 1px solid rgba(223, 169, 56, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.wing-glyph {
  color: #DFA938;
  font-size: 32rpx;
  transform: rotate(45deg);
}

.brand-text-col {
  display: flex;
  flex-direction: column;
}

.brand-title-row {
  display: flex;
  align-items: baseline;
}

.brand-zh {
  font-size: 34rpx;
  font-weight: 900;
  color: #DFA938;
  margin-right: 8rpx;
  letter-spacing: 2rpx;
}

.brand-en {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.brand-badge {
  font-size: 18rpx;
  font-weight: 900;
  color: #F3CE72;
  background: rgba(223, 169, 56, 0.18);
  border: 1px solid rgba(223, 169, 56, 0.4);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
}

.brand-sub {
  font-size: 18rpx;
  color: #94A3B8;
  margin-top: 2rpx;
}

.face-id-pill {
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  background: rgba(15, 19, 28, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.lock-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.face-id-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #CBD5E1;
}

/* 2. Common Card Style */
.card {
  background: #0F131C;
  border-radius: 32rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.6);
  box-sizing: border-box;
}

.card-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.verified-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #34D399;
  background: rgba(6, 78, 59, 0.6);
  border: 1px solid rgba(16, 185, 129, 0.35);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.sub-hint {
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: block;
}

/* 3. Compact Live Countdown Capsule */
.countdown-capsule {
  background: linear-gradient(135deg, #131722, #0A0D14);
  border-radius: 28rpx;
  border: 1px solid rgba(223, 169, 56, 0.45);
  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.7), 0 0 20rpx rgba(223, 169, 56, 0.15);
}

.capsule-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.capsule-left {
  display: flex;
  flex-direction: column;
}

.capsule-tag-row {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #94A3B8;
  margin-bottom: 8rpx;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #DFA938;
  margin-right: 8rpx;
}

.airline-flight {
  color: #F3CE72;
  font-weight: 700;
}

.dot-divider {
  margin: 0 6rpx;
  color: #475569;
}

.gold-bold {
  color: #DFA938;
  font-weight: 800;
}

.white-bold {
  color: #FFFFFF;
  font-weight: 800;
}

.capsule-route-row {
  display: flex;
  align-items: baseline;
}

.route-city {
  font-size: 38rpx;
  font-weight: 900;
  font-family: monospace;
  color: #FFFFFF;
}

.route-plane {
  font-size: 24rpx;
  color: #DFA938;
  margin: 0 12rpx;
}

.ontime-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: #34D399;
  background: rgba(6, 78, 59, 0.7);
  border: 1px solid rgba(16, 185, 129, 0.4);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
}

.capsule-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.countdown-label-row {
  display: flex;
  align-items: center;
}

.countdown-label {
  font-size: 18rpx;
  font-weight: 700;
  color: #DFA938;
  letter-spacing: 1rpx;
}

.arrow-right {
  font-size: 18rpx;
  color: #DFA938;
  margin-left: 4rpx;
}

.countdown-digits {
  font-size: 38rpx;
  font-weight: 900;
  font-family: monospace;
  color: #FEF3C7;
  letter-spacing: 2rpx;
  margin: 4rpx 0;
  text-shadow: 0 0 12rpx rgba(243, 206, 114, 0.6);
}

.countdown-legend {
  font-size: 14rpx;
  font-weight: 700;
  color: #64748B;
  letter-spacing: 2rpx;
}

.capsule-progress-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #020617;
}

.capsule-progress-active {
  height: 100%;
  background: linear-gradient(90deg, #D97706, #FBBF24, #FDE68A);
  box-shadow: 0 0 8rpx rgba(223, 169, 56, 0.9);
}

/* 4. Search Capsule */
.segmented-control {
  display: flex;
  background: #07090E;
  border-radius: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 0;
  border-radius: 16rpx;
  color: #94A3B8;
  transition: all 0.2s ease;
}

.seg-active {
  background: #0284C7;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(2, 132, 199, 0.4);
}

.seg-active-gold {
  background: #D97706;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(217, 119, 6, 0.4);
}

.city-pair-box {
  background: #07090E;
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.city-col {
  display: flex;
  flex-direction: column;
}

.city-left {
  align-items: flex-start;
}

.city-right {
  align-items: flex-end;
}

.airport-code {
  font-size: 52rpx;
  font-weight: 900;
  font-family: monospace;
  color: #FFFFFF;
  line-height: 1;
}

.city-name {
  font-size: 22rpx;
  color: #CBD5E1;
  font-weight: 600;
  margin-top: 8rpx;
}

.swap-btn-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.swap-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #1E293B;
  border: 1px solid rgba(56, 189, 248, 0.4);
  color: #38BDF8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.5);
}

.swap-rotating {
  transform: rotate(180deg);
  transition: transform 0.25s ease;
}

.swap-label {
  font-size: 16rpx;
  color: #64748B;
  margin-top: 6rpx;
}

.date-picker-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.date-col {
  flex: 1;
  background: #07090E;
  border-radius: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 18rpx 22rpx;
}

.date-label {
  font-size: 18rpx;
  color: #94A3B8;
  display: block;
  margin-bottom: 4rpx;
}

.date-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: monospace;
}

.cabin-grid {
  display: flex;
  background: #07090E;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  gap: 8rpx;
}

.cabin-btn {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  padding: 12rpx 0;
  border-radius: 14rpx;
  color: #94A3B8;
}

.cabin-active {
  background: #1E293B;
  color: #FFFFFF;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.search-cta-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #0284C7, #0369A1);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(2, 132, 199, 0.4);
  border: none;
}

.cta-icon {
  margin-right: 12rpx;
}

/* 5. Radar Alert Card */
.radar-alert-card {
  background: linear-gradient(90deg, rgba(6, 78, 59, 0.7), #0F131C);
  border: 1px solid rgba(16, 185, 129, 0.45);
}

.radar-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.radar-title-left {
  display: flex;
  align-items: center;
}

.radar-ping-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #34D399;
  margin-right: 12rpx;
}

.radar-alert-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #6EE7B7;
}

.radar-time {
  font-size: 20rpx;
  color: #94A3B8;
}

.radar-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.radar-flight-pair {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
  display: block;
}

.radar-airline-hint {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 4rpx;
  display: block;
}

.radar-price-col {
  text-align: right;
}

.radar-price {
  font-size: 36rpx;
  font-weight: 900;
  font-family: monospace;
  color: #34D399;
  display: block;
}

.radar-seats {
  font-size: 20rpx;
  font-weight: 700;
  color: #10B981;
  display: block;
}

/* 6. Quick Tools Grid */
.quick-tools-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tool-btn {
  flex: 1;
  background: #0F131C;
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 22rpx;
}

.tool-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.tool-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.tool-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #38BDF8;
}

.tool-desc {
  font-size: 20rpx;
  color: #94A3B8;
  line-height: 1.4;
  display: block;
}

/* 7. Trips Hub: Golden VIP Boarding Pass */
.golden-boarding-pass {
  background: linear-gradient(145deg, #F5D77F, #DFA938, #BF8B23);
  border-radius: 36rpx;
  padding: 32rpx;
  color: #3D2200;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.8), 0 0 30rpx rgba(223, 169, 56, 0.3);
  margin-bottom: 24rpx;
}

.pass-top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pass-airline-meta {
  font-size: 20rpx;
  font-weight: 700;
  opacity: 0.85;
  display: block;
}

.pass-flight-number {
  font-size: 48rpx;
  font-weight: 900;
  font-family: monospace;
  line-height: 1;
  margin-top: 4rpx;
  display: block;
}

.pass-badge-col {
  text-align: right;
}

.pass-class-badge {
  font-size: 20rpx;
  font-weight: 900;
  background: rgba(61, 34, 0, 0.15);
  border: 1px solid rgba(61, 34, 0, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.pass-eticket-text {
  font-size: 18rpx;
  opacity: 0.75;
  margin-top: 4rpx;
  display: block;
}

.pass-route-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1px dashed rgba(61, 34, 0, 0.25);
  border-bottom: 1px dashed rgba(61, 34, 0, 0.25);
}

.pass-time-col {
  display: flex;
  flex-direction: column;
}

.pass-time {
  font-size: 52rpx;
  font-weight: 900;
  font-family: monospace;
  line-height: 1;
}

.pass-airport {
  font-size: 24rpx;
  font-weight: 800;
  margin-top: 6rpx;
}

.pass-code {
  font-size: 20rpx;
  opacity: 0.75;
}

.pass-mid-trajectory {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flight-duration {
  font-size: 18rpx;
  opacity: 0.75;
}

.trajectory-line {
  display: flex;
  align-items: center;
  margin: 6rpx 0;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #3D2200;
}

.line {
  width: 36rpx;
  height: 2rpx;
  background: rgba(61, 34, 0, 0.4);
}

.mid-plane {
  font-size: 22rpx;
  margin: 0 4rpx;
}

.ontime-text {
  font-size: 18rpx;
  font-weight: 800;
}

.pass-details-grid {
  display: flex;
  justify-content: space-between;
  padding-top: 20rpx;
}

.detail-box {
  display: flex;
  flex-direction: column;
}

.d-label {
  font-size: 18rpx;
  opacity: 0.75;
  margin-bottom: 4rpx;
}

.d-val {
  font-size: 28rpx;
  font-weight: 900;
}

.gold-bright {
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.barcode-row {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px dashed rgba(61, 34, 0, 0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.simulated-barcode {
  width: 90%;
  height: 32rpx;
  background: repeating-linear-gradient(90deg, #3D2200, #3D2200 4rpx, transparent 4rpx, transparent 8rpx, #3D2200 8rpx, #3D2200 14rpx, transparent 14rpx, transparent 18rpx);
  opacity: 0.85;
}

.barcode-number {
  font-size: 18rpx;
  font-weight: 700;
  font-family: monospace;
  margin-top: 8rpx;
  opacity: 0.85;
}

/* 8. Inbound Tracking Card */
.inbound-card {
  background: linear-gradient(135deg, rgba(2, 132, 199, 0.15), #0F131C);
  border: 1px solid rgba(56, 189, 248, 0.35);
}

.inbound-plane-badge {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tail-no {
  font-size: 26rpx;
  font-weight: 800;
  color: #38BDF8;
}

.plane-model {
  font-size: 22rpx;
  color: #CBD5E1;
}

.inbound-desc {
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.5;
}

/* 9. Credit Cards Vault */
.cards-deck-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.deck-row {
  display: flex;
  gap: 16rpx;
}

.cc-card {
  min-width: 360rpx;
  height: 200rpx;
  border-radius: 28rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #8A151B, #590C10);
  border: 1px solid rgba(255, 255, 255, 0.15);
  box-sizing: border-box;
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  opacity: 0.75;
}

.cc-blue {
  background: linear-gradient(135deg, #1E3A8A, #0F172A);
}

.cc-green {
  background: linear-gradient(135deg, #065F46, #064E3B);
}

.cc-active {
  opacity: 1;
  border: 2px solid #DFA938;
  box-shadow: 0 10rpx 28rpx rgba(223, 169, 56, 0.3);
}

.cc-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cc-bank {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cc-tier {
  font-size: 18rpx;
  font-weight: 800;
  color: #FDE68A;
  background: rgba(0, 0, 0, 0.4);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.cc-name {
  font-size: 26rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.cc-num {
  font-size: 20rpx;
  font-family: monospace;
  color: #E2E8F0;
}

.card-benefit-box {
  background: #07090E;
  border-radius: 24rpx;
  border: 1px solid rgba(223, 169, 56, 0.3);
  padding: 24rpx;
}

.benefit-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.b-shield {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.b-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #DFA938;
}

.b-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.b-item {
  display: flex;
  flex-direction: column;
}

.b-lbl {
  font-size: 18rpx;
  color: #94A3B8;
  margin-bottom: 4rpx;
}

.b-val {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.claim-pack-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #D97706, #F59E0B);
  color: #3D2200;
  font-size: 22rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.sparkle-icon {
  margin-right: 8rpx;
}

.claim-toast {
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(6, 78, 59, 0.9);
  border: 1px solid #10B981;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #6EE7B7;
  line-height: 1.4;
}

.fee-guide-row {
  background: #07090E;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.fee-label {
  font-size: 22rpx;
  color: #38BDF8;
  font-weight: 700;
  display: block;
}

.fee-val {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
  margin-top: 4rpx;
  display: block;
}

.fee-warning {
  font-size: 20rpx;
  color: #F87171;
  line-height: 1.4;
}

/* 10. Matched Radar Card */
.matched-radar-card {
  border: 1px solid rgba(223, 169, 56, 0.4);
}

.radar-status-badge {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #34D399;
  margin-bottom: 16rpx;
}

.matched-route {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.m-city {
  font-size: 32rpx;
  font-weight: 900;
}

.m-plane {
  color: #DFA938;
}

.matched-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 20rpx;
}

.matched-fixed-price {
  color: #34D399;
  font-weight: 700;
}

.cta-direct-app-btn {
  width: 100%;
  height: 84rpx;
  background: linear-gradient(90deg, #D97706, #F59E0B);
  color: #3D2200;
  font-size: 26rpx;
  font-weight: 900;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

/* 11. Bottom Floating TabBar (4-Tab Switcher) */
.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: rgba(7, 9, 14, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  color: #64748B;
  transition: all 0.2s ease;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.tab-label {
  font-size: 20rpx;
  font-weight: 700;
}

.tab-active {
  color: #DFA938;
}
