/** pages/index/index.wxss **/
/* DirectAir Champagne Obsidian Luxury Style (100% Native v1.38 - 中式高端商务微调版) */

page {
  background-color: #0A0D14;
  color: #F8FAFC;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Segoe UI', Roboto, sans-serif;
  padding-bottom: 160rpx;
}

.container {
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

/* ==================== 1. FULLSCREEN RESPONSIVE CITY SEARCH ==================== */
.fullscreen-city-view {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #0A0D14;
  z-index: 99999;
  display: flex;
  flex-direction: column;
  padding: env(safe-area-inset-top) 24rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  height: 100vh;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.top-spotlight-bar {
  display: flex;
  flex-direction: column;
  background: #0A0D14;
  padding-bottom: 16rpx;
  border-bottom: 1px solid rgba(229, 184, 105, 0.12);
  flex-shrink: 0;
}

.fs-nav-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 18rpx;
}

.fs-back-btn {
  display: flex;
  align-items: center;
  background: #141A26;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.fs-back-arrow {
  color: #E5B869;
  font-size: 28rpx;
  margin-right: 6rpx;
}

.fs-back-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #F8FAFC;
}

.fs-nav-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #E5B869;
  letter-spacing: 1rpx;
}

.fs-cancel-text {
  font-size: 24rpx;
  color: #38BDF8;
  font-weight: 800;
  padding: 8rpx 16rpx;
}

.fs-search-box-top {
  display: flex;
  align-items: center;
  background: #131824;
  border: 1.5px solid #E5B869;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(229, 184, 105, 0.18);
}

.fs-search-icon {
  font-size: 28rpx;
  color: #E5B869;
  margin-right: 14rpx;
}

.fs-input-top {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
  height: 52rpx;
}

.fs-clear-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #1E2638;
  color: #94A3B8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.fs-top-scroll-container {
  flex: 1;
  height: 0;
  box-sizing: border-box;
  padding: 20rpx 0 60rpx;
}

.top-match-group {
  display: flex;
  flex-direction: column;
}

.top-group-label-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.top-group-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #38BDF8;
}

.top-hint-label {
  font-size: 20rpx;
  color: #64748B;
}

.top-compact-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.top-match-row {
  background: #131824;
  border-radius: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.5);
}

.tm-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1C2333, #131824);
  border: 1px solid rgba(229, 184, 105, 0.35);
  color: #E5B869;
  font-size: 28rpx;
  font-weight: 900;
  font-family: monospace;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.tm-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.tm-name-line {
  display: flex;
  align-items: baseline;
}

.tm-city {
  font-size: 28rpx;
  font-weight: 900;
  color: #FFFFFF;
  margin-right: 12rpx;
}

.tm-airport {
  font-size: 22rpx;
  font-weight: 700;
  color: #CBD5E1;
}

.tm-note {
  font-size: 18rpx;
  color: #94A3B8;
  margin-top: 4rpx;
}

.tm-cta {
  background: #0284C7;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.tm-cta-gold {
  background: linear-gradient(135deg, #E5B869, #C89B3C);
  color: #1A1000;
}

/* ==================== NO-AIRPORT NEARBY TRANSIT STYLES ==================== */
.no-airport-transit-box {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  animation: fadeIn 0.2s ease-in-out;
}

.transit-banner-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(229, 184, 105, 0.2), #131824);
  border: 1.5px solid rgba(229, 184, 105, 0.45);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}

.transit-icon-badge {
  font-size: 38rpx;
  margin-right: 18rpx;
}

.transit-title-col {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.transit-main-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #FEF3C7;
}

.transit-sub-title {
  font-size: 20rpx;
  color: #E5B869;
  font-weight: 700;
  margin-top: 4rpx;
}

.transit-reason-card {
  background: #131824;
  border-radius: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 18rpx 22rpx;
}

.tr-reason-text {
  font-size: 22rpx;
  color: #CBD5E1;
  line-height: 1.5;
}

.nearby-hubs-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nearby-hub-card-rich {
  background: #131824;
  border-radius: 28rpx;
  border: 1.5px solid rgba(229, 184, 105, 0.35);
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.5);
  position: relative;
}

.nhr-top-tag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.nhr-tag-badge {
  font-size: 20rpx;
  font-weight: 900;
  color: #FEF3C7;
  background: linear-gradient(90deg, rgba(229, 184, 105, 0.35), rgba(200, 155, 60, 0.15));
  border: 1px solid rgba(229, 184, 105, 0.5);
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

.nhr-score {
  font-size: 20rpx;
  font-weight: 800;
  color: #34D399;
}

.nhr-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.nh-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1C2333, #131824);
  border: 1px solid rgba(229, 184, 105, 0.4);
  color: #E5B869;
  font-size: 30rpx;
  font-weight: 900;
  font-family: monospace;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.nh-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.nh-name-line {
  display: flex;
  align-items: baseline;
}

.nh-city {
  font-size: 30rpx;
  font-weight: 900;
  color: #FFFFFF;
  margin-right: 12rpx;
}

.nh-port {
  font-size: 24rpx;
  font-weight: 700;
  color: #E5B869;
}

.nh-dist-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #94A3B8;
  margin-top: 4rpx;
}

.nh-cta-btn {
  background: linear-gradient(135deg, #E5B869, #C89B3C);
  color: #1A1000;
  font-size: 22rpx;
  font-weight: 900;
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(229, 184, 105, 0.3);
}

.nhr-specs-box {
  background: #0B0E16;
  border-radius: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.06);
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.nhr-spec-item {
  display: flex;
  align-items: flex-start;
  font-size: 20rpx;
  line-height: 1.45;
  color: #CBD5E1;
}

.nhr-spec-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.nhr-spec-text {
  flex: 1;
}

.spec-strong {
  font-weight: 800;
  color: #FFFFFF;
}

.nhr-spec-highlight {
  background: rgba(6, 78, 59, 0.4);
  border-radius: 12rpx;
  padding: 10rpx 14rpx;
  border: 1px solid rgba(16, 185, 129, 0.25);
  color: #6EE7B7;
}

.nhr-spec-highlight .spec-strong {
  color: #34D399;
}

.top-custom-row {
  background: #131824;
  border: 1.5px dashed #E5B869;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Sections in Full-Screen Default State */
.top-sec-block {
  margin-bottom: 32rpx;
}

.top-block-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.top-block-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #E5B869;
  margin-bottom: 14rpx;
  display: block;
}

.top-block-sub {
  font-size: 18rpx;
  color: #64748B;
}

.top-quick-pills-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.top-pill-loc {
  display: flex;
  align-items: center;
  background: rgba(6, 78, 59, 0.7);
  border: 1px solid rgba(16, 185, 129, 0.5);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
}

.loc-dot { color: #34D399; font-size: 20rpx; margin-right: 6rpx; }
.loc-code { font-size: 24rpx; font-weight: 900; font-family: monospace; color: #34D399; margin-right: 8rpx; }
.loc-name { font-size: 22rpx; font-weight: 700; color: #FFFFFF; }

.top-pill-hist {
  display: flex;
  align-items: baseline;
  background: #141A26;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
  padding: 12rpx 18rpx;
}

.hist-code { font-size: 24rpx; font-weight: 900; font-family: monospace; color: #E5B869; margin-right: 6rpx; }
.hist-name { font-size: 22rpx; color: #CBD5E1; }

.top-grid-3col {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
}

.top-hub-pill {
  background: #131824;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 18rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.4);
}

.top-hub-active {
  background: #0284C7;
  border-color: #38BDF8;
}

.thp-code {
  font-size: 30rpx;
  font-weight: 900;
  font-family: monospace;
  color: #E5B869;
}

.top-hub-active .thp-code { color: #FFFFFF; }

.thp-city {
  font-size: 24rpx;
  font-weight: 800;
  color: #FFFFFF;
  margin-top: 4rpx;
}

.thp-port {
  font-size: 16rpx;
  color: #94A3B8;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.top-hub-active .thp-port { color: #E0F2FE; }

/* ==================== 2. BRAND BAR & GENERAL STYLES ==================== */
.brand-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.brand-logo-wrap {
  display: flex;
  align-items: center;
}

.gold-wing-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(229, 184, 105, 0.25), rgba(200, 155, 60, 0.08));
  border: 1px solid rgba(229, 184, 105, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.wing-glyph {
  color: #E5B869;
  font-size: 32rpx;
  transform: rotate(45deg);
}

.brand-text-col {
  display: flex;
  flex-direction: column;
}

.brand-title-row {
  display: flex;
  align-items: baseline;
}

.brand-zh {
  font-size: 34rpx;
  font-weight: 900;
  color: #E5B869;
  margin-right: 8rpx;
  letter-spacing: 2rpx;
}

.brand-en {
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.brand-badge {
  font-size: 18rpx;
  font-weight: 900;
  color: #1A1000;
  background: linear-gradient(135deg, #FDE68A, #E5B869);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
}

.brand-sub {
  font-size: 18rpx;
  color: #94A3B8;
  margin-top: 2rpx;
}

.face-id-pill {
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  background: #131824;
  border: 1px solid rgba(229, 184, 105, 0.25);
}

.lock-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.face-id-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #CBD5E1;
}

/* 3. Common Card Style */
.card {
  background: #131824;
  border-radius: 32rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.5);
  box-sizing: border-box;
}

.card-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.verified-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #34D399;
  background: rgba(6, 78, 59, 0.6);
  border: 1px solid rgba(16, 185, 129, 0.35);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.future-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: #FBBF24;
  background: rgba(217, 119, 6, 0.2);
  border: 1px solid rgba(245, 158, 11, 0.4);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.sub-hint {
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: block;
}

/* 4. Section Title Bar */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 16rpx;
  padding: 0 4rpx;
}

.sec-badge-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.sec-title-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #FFFFFF;
  flex: 1;
}

.sec-title-sub {
  font-size: 20rpx;
  color: #E5B869;
  font-weight: 700;
}

/* 5. Live Countdown Capsule */
.countdown-capsule {
  background: linear-gradient(135deg, #182030, #0E131E);
  border-radius: 28rpx;
  border: 1px solid rgba(229, 184, 105, 0.4);
  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.6), 0 0 20rpx rgba(229, 184, 105, 0.12);
}

.capsule-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.capsule-left {
  display: flex;
  flex-direction: column;
}

.capsule-tag-row {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #94A3B8;
  margin-bottom: 8rpx;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #E5B869;
  margin-right: 8rpx;
}

.airline-flight {
  color: #FEF3C7;
  font-weight: 700;
}

.dot-divider {
  margin: 0 6rpx;
  color: #475569;
}

.gold-bold {
  color: #E5B869;
  font-weight: 800;
}

.white-bold {
  color: #FFFFFF;
  font-weight: 800;
}

.capsule-route-row {
  display: flex;
  align-items: baseline;
}

.route-city {
  font-size: 38rpx;
  font-weight: 900;
  color: #FFFFFF;
}

.route-plane {
  font-size: 24rpx;
  color: #E5B869;
  margin: 0 12rpx;
}

.ontime-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: #34D399;
  background: rgba(6, 78, 59, 0.7);
  border: 1px solid rgba(16, 185, 129, 0.4);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
}

.capsule-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.countdown-label-row {
  display: flex;
  align-items: center;
}

.countdown-label {
  font-size: 18rpx;
  font-weight: 700;
  color: #E5B869;
  letter-spacing: 1rpx;
}

.arrow-right {
  font-size: 18rpx;
  color: #E5B869;
  margin-left: 4rpx;
}

.countdown-digits {
  font-size: 38rpx;
  font-weight: 900;
  font-family: monospace;
  color: #FEF3C7;
  letter-spacing: 2rpx;
  margin: 4rpx 0;
  text-shadow: 0 0 12rpx rgba(229, 184, 105, 0.4);
}

.countdown-legend {
  font-size: 14rpx;
  font-weight: 700;
  color: #64748B;
  letter-spacing: 2rpx;
}

.capsule-progress-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #0B0E16;
}

.capsule-progress-active {
  height: 100%;
  background: linear-gradient(90deg, #C89B3C, #E5B869, #FDE68A);
  box-shadow: 0 0 8rpx rgba(229, 184, 105, 0.8);
}

/* ==================== 6. CHINESE-CENTRIC CITY PAIR CAPSULE (中文大字主导) ==================== */
.segmented-control {
  display: flex;
  background: #0B0E16;
  border-radius: 20rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 0;
  border-radius: 16rpx;
  color: #94A3B8;
}

.seg-active {
  background: #0284C7;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(2, 132, 199, 0.4);
}

.seg-active-gold {
  background: linear-gradient(135deg, #E5B869, #C89B3C);
  color: #1A1000;
  box-shadow: 0 4rpx 12rpx rgba(229, 184, 105, 0.3);
}

.city-pair-box {
  background: #0B0E16;
  border-radius: 24rpx;
  border: 1px solid rgba(229, 184, 105, 0.2);
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.city-col {
  display: flex;
  flex-direction: column;
}

.city-left { align-items: flex-start; }
.city-right { align-items: flex-end; }

.city-hint-label {
  font-size: 18rpx;
  color: #94A3B8;
  font-weight: 700;
  margin-bottom: 6rpx;
}

/* Chinese City is PRIMARY & BOLD */
.city-name-huge {
  font-size: 42rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1.1;
}

.city-sub-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.airport-code-badge {
  font-size: 20rpx;
  font-weight: 900;
  font-family: monospace;
  color: #E5B869;
