<!-- pages/index/index.wxml -->
<!-- 直航 DirectAir 100% 原生全交互体验版 (v1.2.0) -->
<view class="container">

  <!-- ==================== 1. TOP BRAND NAVBAR ==================== -->
  <view class="brand-bar">
    <view class="brand-logo-wrap" bindtap="backToHome">
      <view class="gold-wing-icon">
        <text class="wing-glyph">✈</text>
      </view>
      <view class="brand-text-col">
        <view class="brand-title-row">
          <text class="brand-zh">直航</text>
          <text class="brand-en">DirectAir</text>
          <text class="brand-badge">PRO</text>
        </view>
        <text class="brand-sub">航司官方直通与常旅客雷达</text>
      </view>
    </view>

    <!-- Face ID Security Badge -->
    <view class="face-id-pill">
      <text class="lock-icon">🔒</text>
      <text class="face-id-text">Face ID 保险箱</text>
    </view>
  </view>

  <!-- ==================== VIEW A: FLIGHT SEARCH RESULTS (搜索结果列表) ==================== -->
  <view class="flight-results-view" wx:if="{{currentView === 'flight_results'}}">
    
    <!-- Top Return & Filter Bar -->
    <view class="results-header-bar">
      <view class="back-btn" bindtap="backToHome">
        <text class="back-arrow">←</text>
        <text class="back-text">重新搜索</text>
      </view>
      <view class="route-summary">
        <text class="route-summary-text">{{originCode}} {{originCity}} ✈ {{destCode}} {{destCity}}</text>
        <text class="route-date-summary">{{departDate}} · 共 4 个官方航班</text>
      </view>
    </view>

    <!-- Filter Chips Strip -->
    <scroll-view class="filter-scroll" scroll-x="true">
      <view class="filter-chips-row">
        <view class="chip {{activeFilter === 'ALL' ? 'chip-active' : ''}}" bindtap="setFilter" data-filter="ALL">全量官方</view>
        <view class="chip {{activeFilter === 'WIDE_BODY' ? 'chip-active' : ''}}" bindtap="setFilter" data-filter="WIDE_BODY">💎 宽体大飞机</view>
        <view class="chip {{activeFilter === 'CHEAPEST' ? 'chip-active' : ''}}" bindtap="setFilter" data-filter="CHEAPEST">💰 裸价最低</view>
        <view class="chip {{activeFilter === 'EARLIEST' ? 'chip-active' : ''}}" bindtap="setFilter" data-filter="EARLIEST">⏰ 早班出发</view>
      </view>
    </scroll-view>

    <!-- Transparent Price Moat Notice -->
    <view class="transparency-notice">
      <text class="notice-icon">🛡️</text>
      <text class="notice-text">直航承诺：100% 航司官方原价直通，机建¥50燃油¥0已全包，0捆绑保险、0加价退改！</text>
    </view>

    <!-- Flight Offers Cards List -->
    <view class="flight-list">
      <block wx:for="{{filteredFlights}}" wx:key="id">
        <view class="flight-card" bindtap="openFlightDetail" data-flight="{{item}}">
          
          <!-- Card Top: Airline & Aircraft Model -->
          <view class="f-card-top">
            <view class="airline-row">
              <view class="airline-badge {{item.airlineCode === 'MU' ? 'badge-mu' : (item.airlineCode === 'CA' ? 'badge-ca' : (item.airlineCode === 'CZ' ? 'badge-cz' : 'badge-hu'))}}">
                {{item.airlineCode}}
              </view>
              <text class="f-airline-name">{{item.airlineName}} {{item.flightNo}}</text>
              <text class="f-plane-model">{{item.aircraftModel}}</text>
            </view>
            <view class="punctuality-tag">准点率 {{item.punctuality}}</view>
          </view>

          <!-- Card Mid: Departure - Trajectory - Arrival -->
          <view class="f-card-mid">
            <!-- Departure -->
            <view class="f-leg f-leg-left">
              <text class="f-time">{{item.depTime}}</text>
              <text class="f-airport">{{item.depAirport}} {{item.depTerminal}}</text>
            </view>

            <!-- Middle Duration & Line -->
            <view class="f-mid-path">
              <text class="f-duration">{{item.duration}}</text>
              <view class="f-path-line">
                <view class="f-dot"></view>
                <view class="f-line"></view>
                <text class="f-plane-icon">✈</text>
                <view class="f-line"></view>
                <view class="f-dot"></view>
              </view>
              <text class="f-direct-tag">直飞</text>
            </view>

            <!-- Arrival -->
            <view class="f-leg f-leg-right">
              <text class="f-time">{{item.arrTime}}</text>
              <text class="f-airport">{{item.arrAirport}} {{item.arrTerminal}}</text>
            </view>
          </view>

          <!-- Card Bottom: Transparent Prices Row -->
          <view class="f-card-bottom">
            <view class="price-tags-left">
              <view class="cab-pill cab-eco">
                <text class="cab-name">经济舱</text>
                <text class="cab-price">¥{{item.ecoPrice}}</text>
              </view>
              <view class="cab-pill cab-bus">
                <text class="cab-name">公务舱</text>
                <text class="cab-price">¥{{item.busPrice}}</text>
              </view>
            </view>

            <view class="direct-booking-cta">
              <text class="cta-price-total">¥{{item.ecoPrice + 50}}</text>
              <text class="cta-price-note">含¥50机建</text>
              <view class="cta-btn-mini">直达订票 ></view>
            </view>
          </view>

        </view>
      </block>
    </view>

  </view>

  <!-- ==================== VIEW B: 4 MAIN TABS (首页 / 雷达 / 行程 / 卡包) ==================== -->
  <view wx:if="{{currentView === 'home'}}">

    <!-- ---------------- TAB 1: 首页 (HOME) ---------------- -->
    <view class="tab-content" wx:if="{{activeTab === 'home'}}">
      
      <!-- A. Compact Live Flight Countdown Capsule (Height ~72px, 0 Overflow) -->
      <view class="countdown-capsule" bindtap="switchToTrips">
        <view class="capsule-inner">
          <view class="capsule-left">
            <view class="capsule-tag-row">
              <view class="live-dot"></view>
              <text class="airline-flight">{{currentFlight.airlineName}} {{currentFlight.flightNo}}</text>
              <text class="dot-divider">·</text>
              <text class="gate-text">登机口 <text class="gold-bold">{{currentFlight.gate}}</text></text>
              <text class="dot-divider">·</text>
              <text class="seat-text">座位 <text class="white-bold">{{currentFlight.seat}}</text></text>
            </view>
            <view class="capsule-route-row">
              <text class="route-city">{{currentFlight.originCode}}</text>
              <text class="route-plane">✈</text>
              <text class="route-city">{{currentFlight.destCode}}</text>
              <text class="ontime-badge">准点</text>
            </view>
          </view>

          <view class="capsule-right">
            <view class="countdown-label-row">
              <text class="countdown-label">起飞倒计时</text>
              <text class="arrow-right">></text>
            </view>
            <text class="countdown-digits">{{countdown.hrs}}:{{countdown.mins}}:{{countdown.secs}}</text>
            <text class="countdown-legend">HRS : MIN : SEC</text>
          </view>
        </view>

        <view class="capsule-progress-bar">
          <view class="capsule-progress-active" style="width: 68%;"></view>
        </view>
      </view>

      <!-- B. DirectAir Smart Search Capsule (官网全包查票胶囊) -->
      <view class="card search-card">
        <view class="card-header-row">
          <view class="header-left">
            <text class="header-icon">🔍</text>
            <text class="card-title">官网全包查票</text>
          </view>
          <text class="verified-tag">100% 航司官方直通</text>
        </view>

        <!-- Trip Type Segmented Control -->
        <view class="segmented-control">
          <view class="seg-btn {{tripType === 'ONE_WAY' ? 'seg-active' : ''}}" bindtap="setTripType" data-type="ONE_WAY">单程</view>
          <view class="seg-btn {{tripType === 'ROUND_TRIP' ? 'seg-active' : ''}}" bindtap="setTripType" data-type="ROUND_TRIP">往返</view>
          <view class="seg-btn {{tripType === 'DAY_RETURN' ? 'seg-active-gold' : ''}}" bindtap="setTripType" data-type="DAY_RETURN">当日往返</view>
        </view>

        <!-- City Pair Capsule (可点击选择出发/到达城市) -->
        <view class="city-pair-box">
          <view class="city-col city-left" bindtap="openCityPicker" data-type="origin">
            <text class="city-hint-label">出发地 (点击切换)</text>
            <text class="airport-code">{{originCode}}</text>
            <text class="city-name">{{originCity}} · {{originAirport}}</text>
          </view>

          <view class="swap-btn-wrap" bindtap="swapAirports">
            <view class="swap-btn {{isSwapping ? 'swap-rotating' : ''}}">⇄</view>
            <text class="swap-label">互换</text>
          </view>

          <view class="city-col city-right" bindtap="openCityPicker" data-type="dest">
            <text class="city-hint-label">目的地 (点击切换)</text>
            <text class="airport-code">{{destCode}}</text>
            <text class="city-name">{{destCity}} · {{destAirport}}</text>
          </view>
        </view>

        <!-- Date Row (带微信原生日期选择器) -->
        <view class="date-picker-row">
          <picker class="date-picker-col" mode="date" value="{{departDate}}" start="2026-08-25" end="2027-12-31" bindchange="onDateChange">
            <view class="date-col">
              <text class="date-label">出发日期 (点击修改)</text>
              <text class="date-value">{{departDate}} 📅</text>
            </view>
          </picker>

          <view class="date-col" wx:if="{{tripType !== 'ONE_WAY'}}">
            <text class="date-label">回程日期</text>
            <text class="date-value">{{departDate}} (当日)</text>
          </view>
        </view>

        <!-- Cabin Selection -->
        <view class="cabin-grid">
          <view class="cabin-btn {{selectedCabin === 'ECONOMY' ? 'cabin-active' : ''}}" bindtap="selectCabin" data-cabin="ECONOMY">经济舱</view>
          <view class="cabin-btn {{selectedCabin === 'PREMIUM_ECONOMY' ? 'cabin-active' : ''}}" bindtap="selectCabin" data-cabin="PREMIUM_ECONOMY">超经舱</view>
          <view class="cabin-btn {{selectedCabin === 'BUSINESS' ? 'cabin-active' : ''}}" bindtap="selectCabin" data-cabin="BUSINESS">公务舱</view>
          <view class="cabin-btn {{selectedCabin === 'FIRST' ? 'cabin-active' : ''}}" bindtap="selectCabin" data-cabin="FIRST">头等舱</view>
        </view>

        <!-- Search CTA Button (一键进入搜索结果页) -->
        <button class="search-cta-btn" bindtap="performSearch">
          <text class="cta-icon">🔍</text>
          <text class="cta-text">查询航司官方全量报价 ({{originCode}} ✈ {{destCode}})</text>
        </button>
      </view>

      <!-- C. 24h Radar Release Alert Card -->
      <view class="card radar-alert-card" bindtap="switchToWishlist">
        <view class="radar-top-row">
          <view class="radar-title-left">
            <view class="radar-ping-dot"></view>
            <text class="radar-alert-title">⚡ 24h 愿望雷达放票命中</text>
          </view>
          <text class="radar-time">刚刚</text>
        </view>
        <view class="radar-detail-row">
          <view>
            <text class="radar-flight-pair">{{originCode}} {{originCity}} ✈ {{destCode}} {{destCity}}</text>
            <text class="radar-airline-hint">中国东航 · 适用【随心飞/次卡】</text>
          </view>
          <view class="radar-price-col">
            <text class="radar-price">¥399</text>
            <text class="radar-seats">剩余 2 席 · 可兑换</text>
          </view>
        </view>
      </view>

      <!-- D. Quick Anti-OTA Tools Strip (均可点击展开详细交互) -->
      <view class="quick-tools-grid">
        <view class="tool-btn" bindtap="openNameCorrectionModal">
          <view class="tool-title-row">
            <text class="tool-icon">📝</text>
            <text class="tool-name">姓名改错计算器</text>
          </view>
          <text class="tool-desc">国泰仅$60 / 错字小修免费</text>
        </view>

        <view class="tool-btn" bindtap="openDisruptionModal">
          <view class="tool-title-row">
            <text class="tool-icon">🔄</text>
            <text class="tool-name">航变无损退改证明</text>
          </view>
          <text class="tool-desc">直开航司官方延误公章</text>
        </view>
      </view>
    </view>

    <!-- ---------------- TAB 2: 愿望雷达 (WISHLIST) ---------------- -->
    <view class="tab-content" wx:if="{{activeTab === 'wishlist'}}">
      <view class="card">
        <view class="card-header-row">
          <view class="header-left">
            <text class="header-icon">✨</text>
            <text class="card-title">24h 静默放票雷达</text>
          </view>
          <text class="verified-tag">毫秒级监控中</text>
        </view>
        <text class="sub-hint">专治“航司次卡热门航线秒光”痛点，放票自动推送通知秒级唤起官方 App 抢兑。</text>
        
        <button class="add-monitor-btn" bindtap="addNewMonitorRule">
          <text>+ 添加新的航线监控雷达</text>
        </button>
      </view>

      <!-- Active Matched Card -->
      <view class="card matched-radar-card">
        <view class="radar-status-badge">
          <view class="live-dot"></view>
          <text>监控中 · 发现 2 个可兑换座位</text>
        </view>
        <view class="matched-route">
          <text class="m-city">PEK (北京首都)</text>
          <text class="m-plane">✈</text>
          <text class="m-city">SHA (上海虹桥)</text>
        </view>
        <view class="matched-meta">
          <text>中国东航 MU5101 · 2026-10-01 08:00</text>
          <text class="matched-fixed-price">次卡固定成本 ¥399/段</text>
        </view>
        <button class="cta-direct-app-btn" bindtap="openAirlineDirectApp">
          一键直通航司官方 App 抢兑
        </button>
      </view>
    </view>

    <!-- ---------------- TAB 3: 我的行程 (TRIPS HUB) ---------------- -->
    <view class="tab-content" wx:if="{{activeTab === 'trips'}}">
      
      <!-- Hero Golden VIP Boarding Pass (点击可放大条形码/电子登机牌) -->
      <view class="golden-boarding-pass" bindtap="openBoardingPassModal">
        <view class="pass-top-row">
          <view>
            <text class="pass-airline-meta">中国东方航空 · 波音 777-300ER</text>
            <text class="pass-flight-number">MU5101</text>
          </view>
          <view class="pass-badge-col">
            <text class="pass-class-badge">公务舱 (BUSINESS)</text>
            <text class="pass-eticket-text">点击放大电子登机牌 ></text>
          </view>
        </view>

        <!-- Route Row -->
        <view class="pass-route-row">
          <view class="pass-time-col">
            <text class="pass-time">08:00</text>
            <text class="pass-airport">北京首都 T2</text>
            <text class="pass-code">PEK</text>
          </view>
          <view class="pass-mid-trajectory">
            <text class="flight-duration">2h 15m</text>
            <view class="trajectory-line">
              <view class="dot"></view>
              <view class="line"></view>
              <text class="mid-plane">✈</text>
              <view class="line"></view>
              <view class="dot"></view>
            </view>
            <text class="ontime-text">准点起飞</text>
          </view>
          <view class="pass-time-col text-right">
            <text class="pass-time">10:15</text>
            <text class="pass-airport">上海虹桥 T2</text>
            <text class="pass-code">SHA</text>
          </view>
        </view>

        <!-- Details Grid -->
        <view class="pass-details-grid">
          <view class="detail-box">
            <text class="d-label">登机口</text>
            <text class="d-val gold-bright">C42</text>
          </view>
          <view class="detail-box">
            <text class="d-label">座位号</text>
            <text class="d-val">12F</text>
          </view>
          <view class="detail-box">
            <text class="d-label">行李转盘</text>
            <text class="d-val">04号</text>
          </view>
          <view class="detail-box">
            <text class="d-label">客票号</text>
            <text class="d-val font-mono">781-249...</text>
          </view>
        </view>

        <!-- Barcode -->
        <view class="barcode-row">
          <view class="simulated-barcode"></view>
          <text class="barcode-number">PNR: J8KQ2M · ZHANG/SAN</text>
        </view>
      </view>

      <!-- Inbound Aircraft Tracking B-2079 -->
      <view class="card inbound-card">
        <view class="card-header-row">
          <view class="header-left">
            <text class="header-icon">📡</text>
            <text class="card-title">前序航班实时雷达 (ADS-B)</text>
          </view>
          <text class="ontime-badge">准点入位</text>
        </view>
        <view class="inbound-content">
          <view class="inbound-plane-badge">
            <text class="tail-no">执飞机尾号：B-2079</text>
            <text class="plane-model">波音 777-300ER (宽体机)</text>
          </view>
          <text class="inbound-desc">前序航段【广州白云 ✈ 北京首都 MU5302】已于 06:45 提前着陆，飞机已就位停靠 C42 登机口，绝无连环延误风险。</text>
        </view>
      </view>

      <!-- Lifetime Stats -->
      <view class="card stats-card">
        <view class="card-header-row">
          <text class="card-title">常旅客飞行足迹</text>
          <text class="stats-counter">38 次飞行 · 54,200 km</text>
        </view>
        <view class="stats-grid">
          <view class="stat-col">
            <text class="stat-num">96.2%</text>
            <text class="stat-label">准点率</text>
          </view>
          <view class="stat-col">
            <text class="stat-num">24 次</text>
            <text class="stat-label">东航执飞</text>
          </view>
          <view class="stat-col">
            <text class="stat-num">18 次</text>
            <text class="stat-label">京沪快线</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ---------------- TAB 4: 卡包与工具箱 (WALLET & TOOLS) ---------------- -->
    <view class="tab-content" wx:if="{{activeTab === 'wallet'}}">
      
      <!-- Credit Cards Vault Module -->
      <view class="card">
        <view class="card-header-row">
          <view class="header-left">
            <text class="header-icon">💳</text>
            <text class="card-title">高端信用卡航旅权益金库</text>
          </view>
          <text class="verified-tag">已激活 3 张大白金</text>
        </view>
        <text class="sub-hint">点击卡片切换自动匹配官方免费延误险 · 贵宾厅点数管理 · 一键理赔包生成</text>

        <!-- Horizontal Cards Deck Swiper -->
        <scroll-view class="cards-deck-scroll" scroll-x="true">
          <view class="deck-row">
            <view class="cc-card {{selectedCard === 'cmb' ? 'cc-active' : ''}}" bindtap="selectCard" data-card="cmb">
              <view class="cc-top">
                <text class="cc-bank">招商银行</text>
                <text class="cc-tier">经典白</text>
              </view>
              <text class="cc-name">经典白金信用卡</text>
              <text class="cc-num">•••• 8821 (今日承保中)</text>
            </view>

            <view class="cc-card cc-blue {{selectedCard === 'ccb' ? 'cc-active' : ''}}" bindtap="selectCard" data-card="ccb">
              <view class="cc-top">
                <text class="cc-bank">建设银行</text>
                <text class="cc-tier">大山白</text>
              </view>
              <text class="cc-name">尊享白金卡</text>
              <text class="cc-num">•••• 4902</text>
            </view>

            <view class="cc-card cc-green {{selectedCard === 'bocom' ? 'cc-active' : ''}}" bindtap="selectCard" data-card="bocom">
              <view class="cc-top">
                <text class="cc-bank">交通银行</text>
                <text class="cc-tier">白麒麟</text>
              </view>
              <text class="cc-name">标准白金卡</text>
              <text class="cc-num">•••• 1109</text>
            </view>
          </view>
        </scroll-view>

        <!-- Selected Card Benefits Box -->
        <view class="card-benefit-box">
          <view class="benefit-header">
            <text class="b-shield">🛡️</text>
            <text class="b-title" wx:if="{{selectedCard === 'cmb'}}">招商银行经典白金卡 · 免费延误险</text>
            <text class="b-title" wx:if="{{selectedCard === 'ccb'}}">建设银行大山白 · 免费延误险</text>
            <text class="b-title" wx:if="{{selectedCard === 'bocom'}}">交通银行白麒麟 · 免费延误险</text>
          </view>

          <view class="b-grid" wx:if="{{selectedCard === 'cmb'}}">
            <view class="b-item">
              <text class="b-lbl">起延标准</text>
              <text class="b-val gold-bright">满 3 小时定额赔 ¥600</text>
            </view>
            <view class="b-item">
              <text class="b-lbl">年度限额</text>
              <text class="b-val">最高赔付 ¥4,000</text>
            </view>
            <view class="b-item">
              <text class="b-lbl">机场贵宾厅 (CIP)</text>
              <text class="b-val">剩余 {{loungePoints}} / 每年 6 次</text>
            </view>
            <view class="b-item">
              <text class="b-lbl">里程兑换</text>
              <text class="b-val">1500积分=1000东航里程</text>
            </view>
          </view>

          <view class="b-grid" wx:if="{{selectedCard === 'ccb'}}">
            <view class="b-item">
              <text class="b-lbl">起延标准</text>
              <text class="b-val gold-bright">满 4 小时最高赔 ¥1,000</text>
            </view>
            <view class="b-item">
              <text class="b-lbl">触发条件</text>
              <text class="b-val">持卡自动生效 (免购票)</text>
            </view>
            <view class="b-item">
              <text class="b-lbl">贵宾厅/接送机</text>
              <text class="b-val">5次龙腾 + 3次接送机</text>
            </view>
            <view class="b-item">
              <text class="b-lbl">里程兑换</text>
              <text class="b-val">综合积分兑换三大航</text>
            </view>
          </view>

          <view class="b-grid" wx:if="{{selectedCard === 'bocom'}}">
            <view class="b-item">
              <text class="b-lbl">起延标准</text>
              <text class="b-val gold-bright">满 2 小时赔付 ¥500</text>
            </view>
            <view class="b-item">
              <text class="b-lbl">年度限额</text>
              <text class="b-val">每年最高 ¥4,000</text>
            </view>
            <view class="b-item">
              <text class="b-lbl">贵宾厅</text>
              <text class="b-val">6次沃德 + 6次龙腾</text>
            </view>
            <view class="b-item">
              <text class="b-lbl">里程比例</text>
              <text class="b-val">18积分 = 1里程</text>
            </view>
          </view>

          <!-- 1-Click Generate Claim Pack Button -->
          <button class="claim-pack-btn" bindtap="generateClaimPack">
            <text class="sparkle-icon">✨</text>
            <text>一键生成官方延误理赔材料包 (免开延误证明)</text>
          </button>

          <view class="claim-toast" wx:if="{{claimToast}}">
            <text>✓ 已自动为您打包【13位客票电子收据 + 航司准点验真证明】，支持一键发送至保险公司报案！</text>
          </view>
        </view>
      </view>

      <!-- Frequent Flyer Cards Deck -->
      <view class="card">
        <view class="card-header-row">
          <view class="header-left">
            <text class="header-icon">🪪</text>
            <text class="card-title">航司常旅客会员卡包</text>
          </view>
          <text class="verified-tag">已绑定 2 个航司</text>
        </view>

        <view class="loyalty-card-item card-mu">
          <view class="loyalty-top">
            <text class="loyalty-airline">中国东方航空 · 东方万里行</text>
            <text class="loyalty-tier-badge">金卡会员 (SKYTEAM ELITE PLUS)</text>
          </view>
          <text class="loyalty-balance">48,500 积分</text>
          <text class="loyalty-num">卡号：6102 •••• •••• 4612</text>
        </view>

        <view class="loyalty-card-item card-ca">
          <view class="loyalty-top">
            <text class="loyalty-airline">中国国际航空 · 凤凰知音</text>
            <text class="loyalty-tier-badge">银卡会员 (STAR ALLIANCE)</text>
          </view>
          <text class="loyalty-balance">23,200 里程</text>
          <text class="loyalty-num">卡号：9928 •••• •••• 3812</text>
        </view>
      </view>

    </view>

  </view>

  <!-- ==================== 5. CITY / AIRPORT PICKER MODAL (城市选择器弹窗) ==================== -->
  <view class="modal-mask" wx:if="{{showCityModal}}" bindtap="closeCityModal">
    <view class="modal-sheet" catchtap="preventDumb">
      <view class="modal-sheet-header">
        <text class="modal-sheet-title">选择{{selectingType === 'origin' ? '出发' : '到达'}}机场 / 城市</text>
        <view class="modal-close-btn" bindtap="closeCityModal">✕</view>
      </view>

      <view class="city-grid-section">
        <text class="city-group-title">🔥 热门商务大都会枢纽</text>
        <view class="city-pills-grid">
          <block wx:for="{{cityList}}" wx:key="code">
            <view class="city-pill {{((selectingType === 'origin' ? originCode : destCode) === item.code) ? 'city-pill-active' : ''}}" bindtap="selectCityItem" data-item="{{item}}">
              <text class="cp-code">{{item.code}}</text>
              <text class="cp-name">{{item.city}} · {{item.airport}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 6. FLIGHT DETAIL MODAL (航班退改与舱位明细) ==================== -->
  <view class="modal-mask" wx:if="{{showFlightModal}}" bindtap="closeFlightModal">
    <view class="modal-sheet" catchtap="preventDumb">
      <view class="modal-sheet-header">
        <view>
          <text class="modal-sheet-title">{{selectedFlight.airlineName}} {{selectedFlight.flightNo}}</text>
          <text class="modal-sheet-sub">{{selectedFlight.aircraftModel}} · 准点率 {{selectedFlight.punctuality}}</text>
        </view>
        <view class="modal-close-btn" bindtap="closeFlightModal">✕</view>
      </view>

      <view class="flight-detail-body">
        <!-- Schedule Box -->
        <view class="modal-schedule-box">
          <view class="ms-col">
            <text class="ms-time">{{selectedFlight.depTime}}</text>
            <text class="ms-port">{{selectedFlight.depAirport}} {{selectedFlight.depTerminal}}</text>
          </view>
          <view class="ms-mid">
            <text class="ms-dur">{{selectedFlight.duration}}</text>
            <text class="ms-plane">✈</text>
          </view>
          <view class="ms-col text-right">
            <text class="ms-time">{{selectedFlight.arrTime}}</text>
            <text class="ms-port">{{selectedFlight.arrAirport}} {{selectedFlight.arrTerminal}}</text>
          </view>
        </view>

        <!-- Baggage & Meal -->
        <view class="modal-section">
          <text class="sec-title">🧳 免费行李额与客舱服务</text>
          <view class="sec-box">
            <text class="sec-item">✓ 经济舱免费托运：20kg (1件) + 随身手提 8kg</text>
            <text class="sec-item">✓ 客舱餐饮：包含热正餐 + 饮料畅饮</text>
            <text class="sec-item">✓ 宽体大客机设施：全舱机上高通量 Wi-Fi + 独立充电插座</text>
          </view>
        </view>

        <!-- Official Transparent Pricing Table -->
        <view class="modal-section">
          <text class="sec-title">💰 航司官方全透明报价 (0隐形收费)</text>
          <view class="price-breakdown-box">
            <view class="pb-row">
              <text class="pb-lbl">航司官方裸机票价</text>
              <text class="pb-val">¥{{selectedFlight.ecoPrice}}</text>
            </view>
            <view class="pb-row">
              <text class="pb-lbl">民航发展基金 (机场建设费)</text>
              <text class="pb-val">¥50 (法定标准)</text>
            </view>
            <view class="pb-row">
              <text class="pb-lbl">燃油附加费</text>
              <text class="pb-val">¥0 (当前免征)</text>
            </view>
            <view class="pb-row pb-total">
              <text class="pb-lbl-bold">官方全包支付总计</text>
              <text class="pb-val-bold gold-bright">¥{{selectedFlight.ecoPrice + 50}}</text>
            </view>
          </view>
        </view>

        <!-- Refund Policy Notice -->
        <view class="modal-section">
          <text class="sec-title">🔄 退改签规则 (遵循中国民航局官方标准)</text>
          <view class="sec-box">
            <text class="sec-item">• 起飞前 7 天以上：免费自愿改签 / 退票费 5%</text>
            <text class="sec-item">• 起飞前 7 天至 4 小时：改签 10% / 退票 20%</text>
            <text class="sec-item">• 发生延误超 15 分钟：享 100% 官方全额无损退款！</text>
          </view>
        </view>

        <!-- Handoff Action -->
        <button class="handoff-cta-btn" bindtap="handleOfficialBooking">
          一键直达航司官方直营渠道出票 (¥{{selectedFlight.ecoPrice + 50}})
        </button>
      </view>
    </view>
  </view>

  <!-- ==================== 7. NAME CORRECTION CALCULATOR MODAL (姓名改错计算器) ==================== -->
  <view class="modal-mask" wx:if="{{showNameCorrectionModal}}" bindtap="closeNameCorrectionModal">
    <view class="modal-sheet" catchtap="preventDumb">
      <view class="modal-sheet-header">
        <view>
          <text class="modal-sheet-title">📝 航司姓名改错官方费率计算器</text>
          <text class="modal-sheet-sub">反击 OTA 中介“改名收 80% 强退手续费”套路</text>
        </view>
        <view class="modal-close-btn" bindtap="closeNameCorrectionModal">✕</view>
      </view>

      <view class="modal-body-scroll">
        <!-- Airline Selector Tabs -->
        <view class="airline-switch-grid">
          <view class="as-btn {{correctionAirline === 'CX' ? 'as-active' : ''}}" bindtap="selectCorrectionAirline" data-code="CX">国泰航空</view>
          <view class="as-btn {{correctionAirline === 'MU' ? 'as-active' : ''}}" bindtap="selectCorrectionAirline" data-code="MU">中国东航</view>
          <view class="as-btn {{correctionAirline === 'CA' ? 'as-active' : ''}}" bindtap="selectCorrectionAirline" data-code="CA">中国国航</view>
          <view class="as-btn {{correctionAirline === 'CZ' ? 'as-active' : ''}}" bindtap="selectCorrectionAirline" data-code="CZ">南方航空</view>
        </view>

        <view class="correction-policy-card">
          <view class="cp-header">
            <text class="cp-airline-title" wx:if="{{correctionAirline === 'CX'}}">🇭🇰 国泰航空 (Cathay Pacific) 官方改名规则</text>
            <text class="cp-airline-title" wx:if="{{correctionAirline === 'MU'}}">🇨🇳 中国东方航空官方改名规则</text>
            <text class="cp-airline-title" wx:if="{{correctionAirline === 'CA'}}">🇨🇳 中国国际航空官方改名规则</text>
            <text class="cp-airline-title" wx:if="{{correctionAirline === 'CZ'}}">🇨🇳 中国南方航空官方改名规则</text>
          </view>

          <view class="cp-fee-banner">
            <text class="cp-fee-label">官方真实收费：</text>
            <text class="cp-fee-amount" wx:if="{{correctionAirline === 'CX'}}">$60 美元 (约 ¥430) / 错字小修免费</text>
            <text class="cp-fee-amount" wx:if="{{correctionAirline === 'MU'}}">同音错别字 100% 免费直接修正！</text>
            <text class="cp-fee-amount" wx:if="{{correctionAirline === 'CA'}}">官方收取 ¥100 变更费 / 错字免费</text>
            <text class="cp-fee-amount" wx:if="{{correctionAirline === 'CZ'}}">同音错字免费修正，官方不加收手续费</text>
          </view>

          <view class="cp-steps-box">
            <text class="cp-step-item">1. 切勿在 OTA 平台点击“退票”（OTA 会扣除 50%~80% 退票费）</text>
            <text class="cp-step-item">2. 携带身份证/护照原件直接拨打航司官方客服热线</text>
            <text class="cp-step-item">3. 报出 13 位客票号，客服将在系统中直接更正姓名拼写！</text>
          </view>
        </view>

        <button class="confirm-modal-btn" bindtap="closeNameCorrectionModal">我知道了</button>
      </view>
    </view>
  </view>

  <!-- ==================== 8. FLIGHT DISRUPTION REFUND MODAL (航变无损退改) ==================== -->
  <view class="modal-mask" wx:if="{{showDisruptionModal}}" bindtap="closeDisruptionModal">
    <view class="modal-sheet" catchtap="preventDumb">
      <view class="modal-sheet-header">
        <view>
          <text class="modal-sheet-title">🔄 航变 100% 无损退改维权指南</text>
          <text class="modal-sheet-sub">中国民航局《航班正常管理规定》法定权益</text>
        </view>
        <view class="modal-close-btn" bindtap="closeDisruptionModal">✕</view>
      </view>

      <view class="modal-body-scroll">
        <view class="disruption-rule-box">
          <text class="dr-title">⚖️ 旅客法定核心权益：</text>
          <text class="dr-p">1. **延误 15 分钟及以上**：航司即构成航班变动，旅客享有**100% 全额无损退票权**，免收任何手续费！</text>
          <text class="dr-p">2. **免费自愿改签**：可免费改签至航司前后 7 天内任意直飞航班（即使原购特价票亦享受免费改签）。</text>
          <text class="dr-p">3. **公章延误证明**：航司官网/官方 App 均支持直接下载带红色公章的 PDF 延误证明，用于信用卡理赔。</text>
        </view>

        <button class="confirm-modal-btn" bindtap="closeDisruptionModal">了解维权标准</button>
      </view>
    </view>
  </view>

  <!-- ==================== 9. BOARDING PASS ENLARGED MODAL (电子登机牌大图) ==================== -->
  <view class="modal-mask" wx:if="{{showBoardingPassModal}}" bindtap="closeBoardingPassModal">
    <view class="modal-sheet modal-pass-sheet" catchtap="preventDumb">
      <view class="modal-sheet-header">
        <text class="modal-sheet-title">🎫 官方电子登机牌 (VIP通行)</text>
        <view class="modal-close-btn" bindtap="closeBoardingPassModal">✕</view>
